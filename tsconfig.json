{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "apps/**/*.ts",
    "services/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["tools/oxlint/anti-slop/**"]
}
