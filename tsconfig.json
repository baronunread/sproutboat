{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["apps/**/*.ts", "services/**/*.ts", "tools/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
