{
  "name": "@sproutboat/ikada",
  "version": "0.1.0",
  "description": "Sproutboat design system: tokens and React components on Base UI and Tailwind v4.",
  "keywords": [
    "base-ui",
    "design-system",
    "react",
    "sproutboat",
    "tailwindcss",
    "tokens"
  ],
  "homepage": "https://github.com/baronunread/sproutboat/tree/main/packages/ikada#readme",
  "bugs": "https://github.com/baronunread/sproutboat/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baronunread/sproutboat.git",
    "directory": "packages/ikada"
  },
  "files": [
    "src",
    "DESIGN.md",
    "INVENTORY.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.generated.ts",
    "./theme.css": "./src/theme.css",
    "./charts": "./src/charts/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "tokens": "bun scripts/build-tokens.ts",
    "tokens:check": "bun scripts/build-tokens.ts --check",
    "playground": "vite --config playground/vite.config.ts --host 0.0.0.0",
    "test": "bun test test",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/charts": "1.2.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "axe-core": "^4.14.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3"
  }
}
