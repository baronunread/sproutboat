{
  "name": "@sproutboat/ui",
  "version": "0.1.0",
  "description": "Sproutboat design system: tokens and React components on Base UI and Tailwind v4.",
  "license": "Apache-2.0",
  "files": [
    "src",
    "DESIGN.md",
    "INVENTORY.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.generated.ts",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "tokens": "bun scripts/build-tokens.ts",
    "tokens:check": "bun scripts/build-tokens.ts --check",
    "playground": "vite --config playground/vite.config.ts --host 0.0.0.0",
    "test": "bun test test",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3"
  }
}
