---
// Shared footer. Points at the marketing site + source; "What is this?" links
// to the /about.html page Astro also builds from this project.
---
<footer>
  <a href="/about.html">What is this?</a>
  <span aria-hidden="true">·</span>
  <a href="https://sproutboat.com" target="_blank" rel="noreferrer">sproutboat.com</a>
  <span aria-hidden="true">·</span>
  <a href="https://github.com/baronunread/sproutboat" target="_blank" rel="noreferrer">GitHub</a>
</footer>

<style>
  footer {
    max-width: 780px;
    margin: 40px auto 0;
    padding: 18px 20px 40px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--dim);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  footer a { color: var(--dim); text-decoration: none; }
  footer a:hover { color: var(--accent); text-decoration: underline; }
</style>
