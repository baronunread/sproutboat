# Reference. install.sh writes the real /etc/sproutboat/caddy.env and rewrites it on
# every install and update. Your own settings for the Caddy process (for example
# XDG_DATA_HOME) go in /etc/sproutboat/caddy.local.env instead.
ACME_EMAIL=admin@example.com

# Optional — DNS-01 fallback for hosts where inbound :80 is blocked.
# When set, install.sh pulls a Caddy build with the cloudflare DNS module and
# adds `acme_dns cloudflare` to the Caddyfile. Scope: Zone:Read + DNS:Edit.
# CLOUDFLARE_API_TOKEN=...
