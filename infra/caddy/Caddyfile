# Reference only — install.sh generates the real /etc/caddy/Caddyfile with your
# domain substituted and the dashboard block included only if you enabled it.
#
# Replace fn.example.com with your deployment domain. Certs are per-hostname via
# HTTP-01 / TLS-ALPN-01 — no DNS API. Add `acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}`
# in the global block only if inbound :80 is blocked (DNS-01 fallback).

{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://127.0.0.1:8787/internal/tls/allow
	}
}

# Control API (CLI + dashboard /api).
control.fn.example.com {
	reverse_proxy 127.0.0.1:8787
}

# Dashboard (only if enabled at install time).
dashboard.fn.example.com {
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Every <project>.<user>.<domain> deployment. Cert on demand, gated by control.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
}
