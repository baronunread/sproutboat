[Unit]
Description=Sproutboat dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sproutboat-web
Group=sproutboat
WorkingDirectory=/opt/sproutboat
Environment=PORT=3000
ExecStart=/opt/sproutboat/bun/bin/bun apps/web/dist/server/server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
