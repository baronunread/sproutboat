[Unit]
Description=Porffer control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=porffer-control
Group=porffer
WorkingDirectory=/opt/porffer
Environment=PORT=8787
Environment=PORFFER_ROUTE_SNAPSHOT=/var/lib/porffer/routes.json
Environment=PORFFER_LOG_PATH=/var/lib/porffer/logs/requests.ndjson
# Provisioning can start the health/TLS gate before secrets are configured.
# Deployments remain unavailable until PORFFER_BOOTSTRAP_TOKEN is supplied.
EnvironmentFile=-/etc/porffer/control.env
ExecStart=/opt/porffer/bun/bin/bun apps/control/src/main.ts
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/porffer

[Install]
WantedBy=multi-user.target
