[Unit]
Description=Sproutboat deployment edge router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sproutboat-edge
Group=sproutboat
WorkingDirectory=/opt/sproutboat
Environment=PORT=8080
Environment=SPROUTBOAT_ROUTE_SNAPSHOT=/var/lib/sproutboat/routes.json
Environment=SPROUTBOAT_LOG_PATH=/var/lib/sproutboat/logs/requests.ndjson
# Deployment domain + dashboard URL, written by install.sh.
EnvironmentFile=-/etc/sproutboat/sproutboat.env
# Platform-wide request caps (issue #27). Per-project overrides still tracked there.
Environment=SPROUTBOAT_REQUEST_TIMEOUT_MS=30000
Environment=SPROUTBOAT_RESPONSE_MAX_BYTES=10485760
# Loopback bind (Caddy is the only public listener). Per-node response cache is
# on by default; set SPROUTBOAT_EDGE_CACHE=off to disable it.
Environment=SPROUTBOAT_BIND_HOST=127.0.0.1
# Native runtime: each deployment is a long-lived native-fetch HTTP server
# (Porffor alpha-3 + uWebSockets) started inside the bubblewrap sandbox
# (infra/sandbox/sprout-sandbox.sh). The supervisor assigns it a loopback $PORT;
# the edge reverse-proxies to it. No Docker in the request path.
Environment=SPROUTBOAT_SPROUT_SANDBOX=bwrap
Environment=SPROUTBOAT_SPROUT_SECCOMP=/etc/sproutboat/worker-seccomp.bpf
# Per-worker cgroup scopes need a user manager + linger; the POC instead caps
# the whole edge+sprouts cgroup below and sets SPROUTBOAT_SPROUT_CGROUP=off.
Environment=SPROUTBOAT_SPROUT_CGROUP=off
ExecStart=/opt/sproutboat/bun/bin/bun services/edge/src/main.ts
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sproutboat
# Aggregate cap for the edge plus every sprout + broker it spawns. This is the
# node's density wall, not the VPS: at ~10 MB per (sprout + broker + bwrap) the
# old 1G OOM'd the node around 80-100 deployments while RAM sat unused. Raise it
# in step with the box; it stays the backstop against a runaway tenant since
# per-sprout cgroup caps are off (SPROUTBOAT_SPROUT_CGROUP).
MemoryMax=2500M
MemorySwapMax=0
CPUQuota=200%
# ~5-7 threads per deployment (Bun broker pool + 2x bwrap + uWS); 512 capped
# density near the memory wall too.
TasksMax=2048
# Egress isolation for the edge and every sprout it spawns: they may talk to
# each other over loopback (Caddy -> edge, edge -> worker) but cannot reach the
# host network, the control plane, or the cloud metadata endpoint.
IPAddressDeny=any
IPAddressAllow=localhost
# Unprivileged user namespaces must be permitted for bubblewrap to start.
RestrictNamespaces=user pid ipc uts mnt cgroup

[Install]
WantedBy=multi-user.target
