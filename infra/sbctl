#!/usr/bin/env bash
#
# sbctl — thin host-side control for a single-VPS Sproutboat install.
# Installed to /usr/local/bin/sbctl by install.sh. Wraps systemctl/journalctl
# so you don't memorise four unit names. This is NOT the deploy CLI — that's
# `sproutboat` (npm, runs on your workstation).
#
set -euo pipefail

ROOT=/opt/sproutboat
STATE=/var/lib/sproutboat
TOKEN_FILE=/root/sproutboat-admin.env
UPDATER=/usr/local/lib/sproutboat/update
STAGER=/usr/local/lib/sproutboat/backup-stage
HEALTH=/usr/local/lib/sproutboat/health
ROLLBACK=/usr/local/lib/sproutboat/rollback
PREV=/opt/sproutboat-prev
ETC=/etc/sproutboat
ENGINE=/usr/local/lib/sproutboat/engine
# env_value FILE KEY: the value of KEY=value (parsed, never sourced).
env_value() { [ -f "$1" ] && sed -n "s/^$2=//p" "$1" | tail -1 || true; }
# The install mode (see docs/homelab.md). A box without install.env is a public install.
PROXY=${SB_PROXY:-$(env_value "$ETC/install.env" SB_PROXY)}; PROXY=${PROXY:-caddy}
SCHEME=${SB_SCHEME:-$(env_value "$ETC/install.env" SB_SCHEME)}; SCHEME=${SCHEME:-https}
SERVICES=(sproutboat-control sproutboat-egress sproutboat-edge)
[ "$PROXY" = external ] || SERVICES+=(caddy)
UNITS=("${SERVICES[@]}" sproutboat-backup.timer)

if [ -t 1 ]; then OK=$'\033[1;32m'; NO=$'\033[1;31m'; D=$'\033[2m'; Z=$'\033[0m'
else OK=; NO=; D=; Z=; fi
die() { printf '%s✗%s %s\n' "$NO" "$Z" "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run as root (sudo sbctl ...)"

usage() {
  cat <<EOF
sbctl — Sproutboat single-VPS control

  sbctl up                 start all services
  sbctl down               stop all services
  sbctl restart            restart control + edge + egress (+ caddy unless SB_PROXY=external)
  sbctl status             one-line health per unit
  sbctl logs [name] [-n N] follow logs (name: control|edge|caddy|backup; default: every service)
  sbctl token              print the admin API URL + token
  sbctl mode               print the install mode settings (/etc/sproutboat/install.env)
  sbctl memory             memory caps and current use per unit, against MemTotal
  sbctl preflight          re-run the runtime sandbox checks
  sbctl engine             show which engine (rust|bun) runs the edge and egress
  sbctl engine rust|bun    switch both, restart them (bun is the fallback; engine.env keeps the choice)
  sbctl update             back up, stage a fresh release, run its installer, health-check, roll back on failure
  sbctl update --check     show the installed and target release and the changelog in between; changes nothing
  sbctl health [--json]    run the health gate (units and HTTP checks); exits non-zero when unhealthy
  sbctl rollback [--yes]   return to the release kept in /opt/sproutboat-prev (asks first)
  sbctl backup now|list    take a backup now (prints its name) / list backups
  sbctl backup verify <archive> [--full] [--key FILE]   check an archive (--full: hashes + sqlite integrity)
  sbctl restore <archive> [--force] [--no-config] [--key FILE] [--allow-newer]
                           stop control + edge, restore a backup (state, then /etc/sproutboat and
                           Caddy data), reseed the admin password, fix owners, start
  sbctl uninstall [args]   hand off to install.sh --uninstall
EOF
}

# Run the backups CLI the way the units do: the installer-written env files are
# plain KEY=value lines, safe to source.
backups_cli() {
  ( set -a
    # shellcheck disable=SC1091
    [ ! -f "$ETC/sproutboat.env" ] || . "$ETC/sproutboat.env"
    # shellcheck disable=SC1091
    [ ! -f "$ETC/control.env" ] || . "$ETC/control.env"
    set +a
    cd "$ROOT" && "$ROOT/bun/bin/bun" apps/control/src/backups.ts "$@" )
}

latest_backup() {
  find "$STATE/backups" -maxdepth 1 -type f -name 'sproutboat-*.tar.gz*' 2>/dev/null | sort | tail -n 1 | xargs -r basename 2>/dev/null || true
}

# Copy the restored config over /etc/sproutboat with the owners and modes
# install.sh gives each file, restore Caddy's data, and rewrite the token file.
# $1 is the extracted config dir (holds etc/ and caddy/).
apply_restored_config() {
  local cfg=$1 f rel caddy
  if [ -d "$cfg/etc/sproutboat" ]; then
    while IFS= read -r f; do
      rel=${f#"$cfg/etc/sproutboat/"}
      case "$rel" in
        # Caddy reads its drop-ins itself, and may run as a non-root `caddy` user.
        caddy.d/*) install -d -m 0755 -o root -g root "$ETC/$(dirname "$rel")" || return 1 ;;
        *) install -d -m 0750 -o root -g sproutboat "$ETC/$(dirname "$rel")" || return 1 ;;
      esac
      cp "$f" "$ETC/$rel" || return 1
      case "$rel" in
        caddy.d/*|README.caddy) chown root:root "$ETC/$rel"; chmod 0644 "$ETC/$rel" ;;
        *) chown root:root "$ETC/$rel"; chmod 0600 "$ETC/$rel" ;;
      esac
    done < <(find "$cfg/etc/sproutboat" -type f)
    for f in control.env sproutboat.env backup.key; do
      [ ! -e "$ETC/$f" ] || { chown root:sproutboat "$ETC/$f"; chmod 0640 "$ETC/$f"; }
    done
    [ ! -e "$ETC/caddy.env" ] || { chown root:root "$ETC/caddy.env"; chmod 0640 "$ETC/caddy.env"; }
    [ ! -e "$ETC/install.env" ] || { chown root:root "$ETC/install.env"; chmod 0644 "$ETC/install.env"; }
    for f in egress.env update.env; do
      [ ! -e "$ETC/$f" ] || { chown root:root "$ETC/$f"; chmod 0600 "$ETC/$f"; }
    done
    printf '  restored %s/ (%s files)\n' "$ETC" "$(find "$cfg/etc/sproutboat" -type f | wc -l | tr -d ' ')"
    if [ -f "$ETC/control.env" ] && [ -f "$ETC/sproutboat.env" ]; then
      ( set -a
        # shellcheck disable=SC1091
        . "$ETC/sproutboat.env"
        # shellcheck disable=SC1091
        . "$ETC/control.env"
        set +a
        umask 077
        scheme=$(env_value "$ETC/install.env" SB_SCHEME); scheme=${scheme:-https}
        printf 'SPROUTBOAT_API_URL=%s://control.%s\nSPROUTBOAT_TOKEN=%s\n' \
          "$scheme" "$SPROUTBOAT_DEPLOYMENT_DOMAIN" "$SPROUTBOAT_BOOTSTRAP_TOKEN" > "$TOKEN_FILE" ) || return 1
      chmod 0600 "$TOKEN_FILE"
      printf '  rewrote %s from the restored control.env\n' "$TOKEN_FILE"
    fi
  else
    printf '  no /etc/sproutboat in the archive: env files left as they are\n'
  fi
  if [ -d "$cfg/caddy" ]; then
    [ -x "$STAGER" ] || { echo "$STAGER missing: re-run the installer once" >&2; return 1; }
    caddy=$("$STAGER" --print-caddy-dir) || return 1
    install -d "$caddy" || return 1
    rsync -a "$cfg/caddy/" "$caddy/" || return 1
    chown -R "$(stat -c %u:%g "$caddy")" "$caddy"
    printf '  restored Caddy data into %s\n' "$caddy"
  else
    printf '  no Caddy data in the archive: certificates will be requested again\n'
  fi
}

# changelog_range FILE VERSION: every release section from the top of the changelog
# down to (not including) the heading of VERSION. Prints the whole file from the first
# section when VERSION has no heading.
changelog_range() {
  awk -v v="$2" '
    /^## / {
      h = $0
      sub(/^## \[?v?/, "", h)
      sub(/[] ].*$/, "", h)
      if (h == v) exit
      started = 1
    }
    started { print }
  ' "$1"
}

update_check() {
  local cfg=$ETC/update.env repo pin ref installed commit target tmp
  [ -f "$cfg" ] || die "$cfg not found: run the installer once"
  repo=$(env_value "$cfg" SPROUTBOAT_UPDATE_REPO)
  pin=$(env_value "$cfg" SPROUTBOAT_UPDATE_REF)
  commit=$(env_value "$cfg" SPROUTBOAT_UPDATE_COMMIT)
  [ -n "$repo" ] || die "SPROUTBOAT_UPDATE_REPO is missing from $cfg"
  installed=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/package.json" | head -1)
  ref=${SB_REF:-$pin}
  case "$ref" in
    -*|*' '*|*'..'*|*'~'*|*'^'*|*':'*|*'?'*|*'['*|*'\\'*) die "invalid update ref" ;;
  esac
  if [ -z "$ref" ]; then
    ref=$(git ls-remote --tags --refs --sort=-v:refname "$repo" 'v*' 2>/dev/null |
      grep -E 'refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$' | head -1 | sed 's#.*refs/tags/##' || true)
    [ -n "$ref" ] || die "no stable release tag found for $repo"
  fi
  printf '  installed  version %s, commit %s, ref %s\n' "${installed:-unknown}" "${commit:-unknown}" "${pin:-latest}"
  target=$(git ls-remote "$repo" "refs/tags/$ref" "refs/tags/$ref^{}" "refs/heads/$ref" 2>/dev/null | tail -1 | cut -f1 || true)
  printf '  target     ref %s, commit %s\n' "$ref" "${target:-unknown}"
  if [ -n "$target" ] && [ "$target" = "$commit" ]; then
    printf '  %s✓%s already up to date\n' "$OK" "$Z"
    return 0
  fi
  case "$repo" in
    https://github.com/*) ;;
    *) printf '  changelog is only fetched for github.com repositories\n'; return 0 ;;
  esac
  tmp=$(mktemp)
  repo=${repo%.git}
  if curl -fsSL -m 20 "https://raw.githubusercontent.com/${repo#https://github.com/}/$ref/CHANGELOG.md" -o "$tmp" 2>/dev/null; then
    printf '\n  Changes from %s to %s (read the "Breaking and operator actions" parts first):\n\n' "${installed:-the installed version}" "$ref"
    changelog_range "$tmp" "$installed"
  else
    printf '  could not download the changelog of %s\n' "$ref"
  fi
  rm -f "$tmp"
}

unit_of() { case "$1" in
  control|edge) echo "sproutboat-$1" ;;
  caddy) [ "$PROXY" != external ] || die "this install has no Caddy (SB_PROXY=external): look at your own proxy's logs"; echo caddy ;;
  backup) echo sproutboat-backup ;;
  *) die "unknown service '$1' (control|edge|caddy|backup)" ;;
esac; }

# MiB from a systemd byte value ("infinity" and "[not set]" pass through).
mib() { case "$1" in ''|*[!0-9]*) printf '%s' "${1:-n/a}" ;; *) printf '%sM' $(( $1 / 1048576 )) ;; esac; }

memory_report() {
  local total avail u max high cur sum=0 reserve=400 budget
  total=$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)
  avail=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)
  printf '  MemTotal      %sM\n  MemAvailable  %sM\n\n' "$total" "$avail"
  printf '  %-22s %10s %10s %10s\n' unit MemoryMax MemoryHigh MemoryCurrent
  for u in sproutboat-control sproutboat-edge sproutboat-egress $([ "$PROXY" = external ] || echo caddy) sproutboat-backup; do
    max=$(systemctl show -p MemoryMax --value "$u" 2>/dev/null || true)
    high=$(systemctl show -p MemoryHigh --value "$u" 2>/dev/null || true)
    cur=$(systemctl show -p MemoryCurrent --value "$u" 2>/dev/null || true)
    printf '  %-22s %10s %10s %10s\n' "$u" "$(mib "$max")" "$(mib "$high")" "$(mib "$cur")"
    # The backup is a transient nightly job; it is not part of the steady-state sum.
    case "$max" in ''|*[!0-9]*) ;; *) [ "$u" = sproutboat-backup ] || sum=$(( sum + max / 1048576 )) ;; esac
  done
  budget=$(( total - reserve ))
  printf '\n  sum of MemoryMax (steady state) %sM, MemTotal minus %sM OS reserve %sM: ' "$sum" "$reserve" "$budget"
  if [ "$sum" -le "$budget" ]; then printf '%sfits%s\n' "$OK" "$Z"; else printf '%sOVER BUDGET%s\n' "$NO" "$Z"; fi
}

cmd=${1:-status}; shift || true
case "$cmd" in
  up)      systemctl start "${UNITS[@]}"; exec "$0" status ;;
  down)    systemctl stop  "${UNITS[@]}" ;;
  restart) systemctl restart "${SERVICES[@]}"; exec "$0" status ;;
  status)
    for u in "${UNITS[@]}"; do
      if systemctl is-active --quiet "$u"; then printf '  %s●%s %-26s %s\n' "$OK" "$Z" "$u" "$(systemctl show -p ActiveState --value "$u")"
      else printf '  %s●%s %-26s %s%s%s\n' "$NO" "$Z" "$u" "$D" "$(systemctl is-active "$u" 2>/dev/null || true) — journalctl -u $u" "$Z"; fi
    done ;;
  logs)
    n=200; sel=()
    while [ $# -gt 0 ]; do case "$1" in
      -n) n=$2; shift 2 ;;
      *) sel+=("$(unit_of "$1")"); shift ;;
    esac; done
    [ ${#sel[@]} -gt 0 ] || sel=("${SERVICES[@]}")
    args=(); for u in "${sel[@]}"; do args+=(-u "$u"); done
    exec journalctl -n "$n" -f "${args[@]}" ;;
  token)
    [ -f "$TOKEN_FILE" ] || die "$TOKEN_FILE not found — is this a Sproutboat host?"
    cat "$TOKEN_FILE" ;;
  memory) memory_report ;;
  mode)
    if [ -f "$ETC/install.env" ]; then
      printf '%s\n' "$ETC/install.env:"
      grep -v '^#' "$ETC/install.env" | sed 's/^/  /'
    else
      printf 'no %s: a public install (SB_MODE=public SB_PROXY=caddy SB_FIREWALL=ufw SB_SCHEME=https)\n' "$ETC/install.env"
    fi ;;
  preflight) exec sh -c "cd '$ROOT' && '$ROOT/bun/bin/bun' run runtime:preflight" ;;
  engine)
    [ -x "$ENGINE" ] || die "$ENGINE missing: re-run the installer once"
    case "${1:-status}" in
      status) exec "$ENGINE" status ;;
      rust|bun)
        "$ENGINE" set both "$1"
        systemctl restart sproutboat-egress sproutboat-edge
        exec "$0" status ;;
      *) die "usage: sbctl engine [rust|bun]" ;;
    esac ;;
  update)
    if [ "${1:-}" = --check ]; then update_check; exit 0; fi
    [ -x "$UPDATER" ] || die "$UPDATER missing: re-run the installer once"
    exec "$UPDATER" "$@" ;;
  health)
    [ -x "$HEALTH" ] || die "$HEALTH missing: run sbctl update once"
    exec "$HEALTH" "$@" ;;
  rollback)
    yes=0
    case "${1:-}" in
      --yes|-y) yes=1 ;;
      '') ;;
      *) die "usage: sbctl rollback [--yes]" ;;
    esac
    [ -x "$ROLLBACK" ] || die "$ROLLBACK missing: run sbctl update once, or restore a backup (sbctl restore)"
    [ -f "$PREV/RELEASE" ] || die "no previous release is kept in $PREV (it is written by sbctl update)"
    printf 'The previous release in %s:\n' "$PREV"
    sed 's/^/  /' "$PREV/RELEASE"
    printf 'Rolling back replaces /opt/sproutboat and the config, units and helper scripts, and restarts the services.\nThe database is not touched (a newer schema is tolerated by the previous release).\n'
    if [ "$yes" = 0 ]; then
      [ -t 0 ] || die "not a terminal; re-run with: sbctl rollback --yes"
      read -r -p "Roll back now? [y/N] " answer
      case "$answer" in y|Y|yes) ;; *) die "aborted" ;; esac
    fi
    exec "$ROLLBACK" ;;
  backup)
    sub=${1:-}; [ $# -eq 0 ] || shift
    case "$sub" in
      now)
        systemctl start sproutboat-backup.service
        latest_backup ;;
      list) backups_cli list ;;
      verify)
        archive=; vargs=()
        while [ $# -gt 0 ]; do case "$1" in
          --full) vargs+=(--full); shift ;;
          --key) [ $# -ge 2 ] || die "--key needs a file"; vargs+=(--key "$2"); shift 2 ;;
          -*) die "usage: sbctl backup verify <archive> [--full] [--key FILE]" ;;
          *) archive=$1; shift ;;
        esac; done
        [ -f "$archive" ] || die "usage: sbctl backup verify <archive> [--full] [--key FILE]"
        backups_cli verify "$(realpath "$archive")" "${vargs[@]}" ;;
      *) die "usage: sbctl backup now|list|verify <archive> [--full] [--key FILE]" ;;
    esac ;;
  restore)
    usage_restore="usage: sbctl restore <archive> [--force] [--no-config] [--key FILE] [--allow-newer]"
    archive=; rargs=(); noconfig=0
    while [ $# -gt 0 ]; do case "$1" in
      --force|--allow-newer) rargs+=("$1"); shift ;;
      --no-config) noconfig=1; shift ;;
      --key) [ $# -ge 2 ] || die "--key needs a file"; rargs+=(--key "$(realpath "$2")"); shift 2 ;;
      -*) die "$usage_restore" ;;
      *) [ -z "$archive" ] || die "$usage_restore"; archive=$1; shift ;;
    esac; done
    [ -f "$archive" ] || die "$usage_restore"
    archive=$(realpath "$archive")
    cfg=$(mktemp -d /var/tmp/sb-restore-config.XXXXXXXX)
    trap 'rm -rf "$cfg"' EXIT
    if [ "$noconfig" = 1 ]; then rargs+=(--no-config); else rargs+=(--config-dir "$cfg"); fi
    # Nothing may hold the databases open while they are replaced.
    systemctl stop sproutboat-backup.timer sproutboat-control sproutboat-edge
    rc=0
    backups_cli restore "$archive" "${rargs[@]}" || rc=$?
    # Owners and modes as install.sh sets them: control owns its database, routes
    # and artifacts; the edge owns binding data, which both share through the group.
    for f in sproutboat.sqlite routes.json deployments.json secrets.key artifacts; do
      [ -e "$STATE/$f" ] && chown -R sproutboat-control:sproutboat "$STATE/$f"
    done
    for d in brokers resources; do
      [ -d "$STATE/$d" ] || continue
      chown -R sproutboat-edge:sproutboat "$STATE/$d"
      chmod -R g+rwX "$STATE/$d"
    done
    # Host config next (it replaces the env files the rest of this reads), then
    # the admin password: the restored database holds the old box's hash while
    # control.env holds the token to log in with.
    config_applied=0
    if [ "$rc" = 0 ] && [ "$noconfig" = 0 ] && [ -d "$cfg/config" ]; then
      apply_restored_config "$cfg/config" || rc=$?
      config_applied=1
    fi
    if [ "$rc" = 0 ]; then
      ( set -a
        # shellcheck disable=SC1091
        . "$ETC/sproutboat.env"
        # shellcheck disable=SC1091
        . "$ETC/control.env"
        set +a
        cd "$ROOT" && "$ROOT/bun/bin/bun" apps/control/src/auth-admin.ts reset-password ) || rc=$?
    fi
    # No Caddy to reload on an SB_PROXY=external install.
    [ "$config_applied" = 0 ] || [ "$(env_value "$ETC/install.env" SB_PROXY)" = external ] || systemctl reload-or-restart caddy || true
    [ "$config_applied" = 0 ] || systemctl restart sproutboat-egress || true
    systemctl start sproutboat-control sproutboat-edge sproutboat-backup.timer
    [ "$rc" = 0 ] || die "restore failed (exit $rc); the services were restarted on the state as it was"
    printf '%s✓%s restored %s\n' "$OK" "$Z" "$archive"
    rm -rf "$cfg"
    exec "$0" status ;;
  uninstall)
    [ -x "$ROOT/install.sh" ] || die "$ROOT/install.sh missing"
    exec "$ROOT/install.sh" --uninstall "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
