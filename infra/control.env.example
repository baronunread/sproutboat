# Copy to /etc/sproutboat/control.env on the VPS. Never commit real values.
BETTER_AUTH_SECRET=replace-with-a-generated-32-byte-or-longer-secret
BETTER_AUTH_URL=https://dashboard.sproutboat.com
GITHUB_CLIENT_ID=replace-with-the-sproutboat-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-the-sproutboat-github-oauth-client-secret
# Local development only: point Better Auth at an Emulate GitHub service.
# GITHUB_EMULATOR_URL=http://localhost:4000
SPROUTBOAT_DATABASE_PATH=/var/lib/sproutboat/sproutboat.sqlite
SPROUTBOAT_ROUTE_SNAPSHOT=/var/lib/sproutboat/routes.json
SPROUTBOAT_ARTIFACTS_DIR=/var/lib/sproutboat/artifacts
SPROUTBOAT_DEPLOYMENTS_PATH=/var/lib/sproutboat/deployments.json
# Transitional operator CLI path. Browser deployments use a signed-in user's
# Better Auth session and their reserved namespace.
SPROUTBOAT_BOOTSTRAP_USERNAME=replace-with-your-namespace
SPROUTBOAT_BOOTSTRAP_TOKEN=replace-with-a-high-entropy-deployment-token
# Comma-separated GitHub account emails allowed to view platform-wide data.
SPROUTBOAT_OPERATOR_EMAILS=operator@example.com
