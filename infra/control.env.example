# Reference. install.sh writes the real /etc/sproutboat/control.env for you, and
# rewrites it on every install and update. Do not edit it: put your own settings
# in /etc/sproutboat/control.local.env (read right after it, never rewritten).
# See "Where settings live" in infra/README.md.

# --- written by install.sh, in control.env ---
SPROUTBOAT_DATABASE_PATH=/var/lib/sproutboat/sproutboat.sqlite
SPROUTBOAT_ARTIFACTS_DIR=/var/lib/sproutboat/artifacts
SPROUTBOAT_DEPLOYMENTS_PATH=/var/lib/sproutboat/deployments.json
SPROUTBOAT_BOOTSTRAP_USERNAME=admin
SPROUTBOAT_BOOTSTRAP_TOKEN=<64 hex chars: openssl rand -hex 32>
SPROUTBOAT_ADMIN_EMAILS=you@example.com
BETTER_AUTH_SECRET=<64 hex chars>
BETTER_AUTH_URL=https://dashboard.<domain>
SPROUTBOAT_BACKUP_KEY_FILE=/etc/sproutboat/backup.key
# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET too, when GitHub sign-in is on.

# --- yours, in control.local.env (examples) ---
# SPROUTBOAT_BACKUP_ENCRYPT=off
# SPROUTBOAT_BACKUP_S3_BUCKET=my-sproutboat-backups
# SPROUTBOAT_BACKUP_S3_ACCESS_KEY_ID=...
# SPROUTBOAT_BACKUP_S3_SECRET_ACCESS_KEY=...
# SPROUTBOAT_MAX_PROJECTS_PER_ACCOUNT=100

# Domain + dashboard URL live in /etc/sproutboat/sproutboat.env (shared with the edge).
