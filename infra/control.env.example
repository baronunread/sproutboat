# Copy to /etc/porffer/control.env on the VPS. Never commit real values.
BETTER_AUTH_SECRET=replace-with-a-generated-32-byte-or-longer-secret
BETTER_AUTH_URL=https://dashboard.porffer.dev
GITHUB_CLIENT_ID=replace-with-the-porffer-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-the-porffer-github-oauth-client-secret
# Local development only: point Better Auth at an Emulate GitHub service.
# GITHUB_EMULATOR_URL=http://localhost:4000
PORFFER_DATABASE_PATH=/var/lib/porffer/porffer.sqlite
PORFFER_ROUTE_SNAPSHOT=/var/lib/porffer/routes.json
PORFFER_ARTIFACTS_DIR=/var/lib/porffer/artifacts
PORFFER_DEPLOYMENTS_PATH=/var/lib/porffer/deployments.json
# Transitional operator CLI path. Browser deployments use a signed-in user's
# Better Auth session and their reserved namespace.
PORFFER_BOOTSTRAP_USERNAME=replace-with-your-namespace
PORFFER_BOOTSTRAP_TOKEN=replace-with-a-high-entropy-deployment-token
# Comma-separated GitHub account emails allowed to view platform-wide data.
PORFFER_OPERATOR_EMAILS=operator@example.com
