{
  "name": "sproutboat",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install || true",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "edge": "bun run services/edge/src/main.ts",
    "control": "bun run apps/control/src/main.ts",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "dev:local": "bun run tools/dev-local.ts",
    "seed": "bun run tools/seed-local.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test": "bun test apps/ services/ tests/",
    "measure:coldstart": "bun tools/measure-coldstart.ts",
    "lint": "oxlint .",
    "style": "style-doctor --quiet",
    "doctor": "react-doctor apps/web --no-telemetry --blocking warning -y",
    "doctor:staged": "react-doctor . --no-telemetry --blocking warning --staged -y",
    "typecheck": "tsc --noEmit && tsc -p apps/web --noEmit",
    "check": "bun run tools/check.ts",
    "runtime:preflight": "bun run tools/runtime-preflight.ts",
    "sandbox:smoke": "bun run tools/sandbox-smoke.ts",
    "diff": "bun run tools/diff.ts",
    "report": "bun run tools/report.ts",
    "validate": "bun run typecheck && bun run test && bun run tools/check.ts && bun run tools/diff.ts && bun run tools/report.ts",
    "retest": "bun run validate"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@sproutboat/artifact": "^0.3.0",
    "@sproutboat/assets": "^0.3.0",
    "@sproutboat/config": "^0.6.0",
    "@sproutboat/runtime": "^0.39.0",
    "@sproutboat/toolchain": "^0.21.3",
    "@sproutboat/wire": "^0.21.2",
    "@tanstack/charts": "^0.16.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "19",
    "react-dom": "19",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "2.2.2",
    "nitro": "^3.0.260610-beta",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "portless": "0.15.12",
    "react-doctor": "0.9.18",
    "style-doctor": "0.5.2",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
